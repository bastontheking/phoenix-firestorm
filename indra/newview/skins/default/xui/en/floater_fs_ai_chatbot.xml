<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 name="fs_ai_chatbot"
 title="ChatBot"
 short_title="ChatBot"
 can_resize="true"
 can_minimize="true"
 can_close="true"
 height="320"
 width="420"
 min_height="200"
 min_width="320"
 layout="topleft"
 save_rect="true">
  <floater.string name="title_single">ChatBot</floater.string>
  <floater.string name="title_history">ChatBot (History)</floater.string>
  <floater.string name="welcome_single">Ask your AI anything. Each message is answered on its own (no history). Nothing here is sent to Second Life.</floater.string>
  <floater.string name="welcome_history">Ask your AI anything. This conversation is remembered between sessions; type /clear to erase it. Nothing here is sent to Second Life.</floater.string>
  <floater.string name="you">You</floater.string>
  <floater.string name="bot">ChatBot</floater.string>
  <floater.string name="thinking">ChatBot is thinking...</floater.string>
  <floater.string name="searching">Searching the web...</floater.string>
  <floater.string name="sources">Sources:</floater.string>
  <floater.string name="cleared">Conversation cleared.</floater.string>

  <text_editor
   follows="all"
   layout="topleft"
   left="4"
   right="-4"
   top="4"
   height="268"
   wrap="true"
   parse_urls="true"
   track_end="true"
   font="SansSerifSmall"
   name="chatbot_history" />

  <text
   follows="left|bottom|right"
   layout="topleft"
   left="6"
   right="-4"
   top_pad="2"
   height="16"
   use_ellipses="true"
   text_color="LtGray_50"
   name="chatbot_status" />

  <line_editor
   follows="left|bottom|right"
   layout="topleft"
   left="4"
   right="-110"
   top_pad="2"
   height="23"
   max_length_bytes="4000"
   spellcheck="true"
   label="Message the ChatBot"
   name="chatbot_input" />
  <button
   follows="right|bottom"
   layout="topleft"
   right="-80"
   top_delta="0"
   height="23"
   width="26"
   image_hover_unselected="Toolbar_Middle_Over"
   image_selected="Toolbar_Middle_Selected"
   image_unselected="Toolbar_Middle_Off"
   image_overlay="Icon_Gear_Foreground"
   label=""
   tool_tip="AI settings (server, web search, clear history)"
   name="chatbot_settings_btn" />
  <button
   follows="right|bottom"
   layout="topleft"
   right="-4"
   top_delta="0"
   height="23"
   width="72"
   label="Send"
   name="chatbot_send_btn" />
</floater>
